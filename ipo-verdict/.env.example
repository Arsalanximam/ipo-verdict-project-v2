# Copy this file to .env and fill in your own values. Never commit .env itself.

# Only needed if you want the LLM-written verdict paragraph.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# SQLite by default. Swap for a Postgres URL in production (Render/Railway give you one free).
DATABASE_URL=sqlite:///./ipo.db

# How often the background scheduler refreshes cached data, in minutes.
REFRESH_INTERVAL_MINUTES=30

# How long a cached snapshot is considered fresh before a request forces a re-scrape.
CACHE_TTL_MINUTES=20

# Allowed origins for CORS, comma-separated. Add your deployed frontend's URL here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,*
